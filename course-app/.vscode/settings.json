{
  // The lesson data files are large generated-ish blobs. Keep them out of
  // quick-open and search noise, but still editable when you want them.
  "search.exclude": {
    "**/scratch": true,
    "**/__pycache__": true,
    "**/.venv": true,
    "dist/**": true
  },
  "files.exclude": {
    "**/__pycache__": true,
    "**/*.pyc": true
  },

  "files.associations": {
    "static/js/data/*.js": "javascript"
  },

  // Flask templates are Jinja, not plain HTML — this stops the formatter
  // mangling {% %} tags.
  "emmet.includeLanguages": {
    "jinja-html": "html"
  },

  "[python]": {
    "editor.rulers": [88],
    "editor.formatOnSave": false
  },
  "[javascript]": {
    "editor.tabSize": 2
  },
  "[css]": {
    "editor.tabSize": 2
  },

  "editor.bracketPairColorization.enabled": true,
  "editor.guides.bracketPairs": "active",
  "editor.renderWhitespace": "boundary"
}
