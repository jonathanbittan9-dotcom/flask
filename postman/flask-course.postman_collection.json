    {
      "name": "02 Routing",
      "description": "Run: flask --app lessons/02-routing-and-params/demo.py run --debug",
      "item": [
        {
          "name": "List books",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/books?genre=scifi&limit=10",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "books"
              ],
              "query": [
                {
                  "key": "genre",
                  "value": "scifi"
                },
                {
                  "key": "limit",
                  "value": "10"
                }
              ]
            }
          }
        },
        {
          "name": "Bad limit (400)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/books?limit=banana",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "books"
              ],
              "query": [
                {
                  "key": "limit",
                  "value": "banana"
                }
              ]
            }
          }
        },
        {
          "name": "Get book by id",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/books/:book_id",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "books",
                ":book_id"
              ],
              "variable": [
                {
                  "key": "book_id",
                  "value": "2"
                }
              ]
            }
          }
        },
        {
          "name": "Book that doesn't exist",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/books/:book_id",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "books",
                ":book_id"
              ],
              "variable": [
                {
                  "key": "book_id",
                  "value": "99"
                }
              ]
            }
          }
        },
        {
          "name": "Converter mismatch (404)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/books/abc",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "books",
                "abc"
              ]
            }
          }
        },
        {
          "name": "Float converter",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/temperature/:celsius",
              "host": [
