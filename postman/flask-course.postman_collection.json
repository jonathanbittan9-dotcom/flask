    {
      "name": "03 JSON",
      "description": "Run: flask --app lessons/03-json/demo.py run --debug",
      "item": [
        {
          "name": "Echo JSON",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{base_url}}/echo",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "echo"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n    \"name\": \"jonathan\",\n    \"password\": \"123\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Create product",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{base_url}}/products",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "products"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n    \"name\": \"Keyboard\",\n    \"price\": 49.9\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 201\", () => pm.response.to.have.status(201));",
                  "",
                  "const body = pm.response.json();",
                  "pm.test(\"returns the product with an id\", () => {",
                  "    pm.expect(body.name).to.eql(\"Keyboard\");",
                  "    pm.expect(body).to.have.property(\"id\");",
                  "});",
                  "pm.test(\"Location header points at it\", () => {",
                  "    pm.expect(pm.response.headers.get(\"Location\")).to.eql(`/products/${body.id}`);",
                  "});",
                  "",
                  "// Save the id so \"Get created product\" can use {{product_id}}.",
                  "pm.collectionVariables.set(\"product_id\", body.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Get created product",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/products/{{product_id}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "products",
                "{{product_id}}"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"it's the product we created\", () => {",
                  "    pm.expect(pm.response.json().id).to.eql(Number(pm.collectionVariables.get(\"product_id\")));",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "List products",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/products",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "products"
              ]
            }
          }
        },
        {
          "name": "Invalid: price is a string",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{base_url}}/products",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "products"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n    \"name\": \"Mouse\",\n    \"price\": \"20\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 400\", () => pm.response.to.have.status(400));",
                  "pm.test(\"explains the problem\", () => pm.expect(pm.response.json().error).to.eql(\"price must be a number\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "Invalid: missing fields",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{base_url}}/products",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "products"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Invalid: body is a list",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{base_url}}/products",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "products"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "[\"Mouse\", 20]",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "product_id",
      "value": ""
    }
  ]
